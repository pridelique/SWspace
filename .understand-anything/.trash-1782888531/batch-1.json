    {
      "id": "file:portal/admin.py",
      "type": "file",
      "name": "admin.py",
      "filePath": "portal/admin.py",
      "summary": "Registers all eight portal models with Django's admin interface, configuring list display, search fields, and filters for News, VolunteerLink, Competition, StudyNote, ProblemReport, PointActivity, PointSubmission, and UserPointProfile.",
      "tags": ["configuration", "admin", "service", "data-model"],
      "complexity": "moderate"
    },
    {
      "id": "file:portal/management/commands/archive_old_media.py",
      "type": "file",
      "name": "archive_old_media.py",
      "filePath": "portal/management/commands/archive_old_media.py",
      "summary": "Django management command that locates portal model records older than a configurable number of months, compresses their images using Pillow, and re-saves them to either local storage or Cloudinary to reduce storage footprint.",
      "tags": ["utility", "script", "data-pipeline", "maintenance"],
      "complexity": "moderate",
      "languageNotes": "Uses a dual-backend save strategy: detects CLOUDINARY_STORAGE settings at runtime and routes to either _save_cloudinary or _save_local accordingly."
    },
    {
      "id": "file:portal/management/commands/clear_mock_data.py",
      "type": "file",
      "name": "clear_mock_data.py",
      "filePath": "portal/management/commands/clear_mock_data.py",
      "summary": "Django management command that deletes all mock data records from every portal model, cleans up associated media files, and prompts for user confirmation before proceeding.",
      "tags": ["utility", "script", "test", "maintenance"],
      "complexity": "simple"
    },
    {
      "id": "file:portal/management/commands/seed_mock_data.py",
