    {
      "id": "file:portal/models.py",
      "type": "file",
      "name": "models.py",
      "filePath": "portal/models.py",
      "summary": "Defines the eight core Django ORM models for the portal app — News, VolunteerLink, Competition, StudyNote, ProblemReport, PointActivity, PointSubmission, and UserPointProfile — with is_published/is_approved flags, foreign keys to the custom user model, and optional media fields.",
      "tags": ["data-model", "service", "schema-definition"],
      "complexity": "complex",
      "languageNotes": "Follows a consistent Django model pattern: each committee-managed model uses is_published and a created_by FK, while student-submitted models use is_approved or a status choice field with a submitted_by FK."
    },
